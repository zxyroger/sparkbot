# SparkBot 配置示例
# 复制为 .env 后按需修改。所有项都可以用环境变量覆盖，前缀统一为 SPARKBOT_。

# ---------------------------------------------------------------------------
# 服务端
# ---------------------------------------------------------------------------
SPARKBOT_SERVER_HOST=0.0.0.0
SPARKBOT_SERVER_PORT=8765
SPARKBOT_SERVER_WS_PATH=/robot
SPARKBOT_SERVER_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# 设备网关
# ---------------------------------------------------------------------------
# 下发给设备的心跳/遥测周期（毫秒）
SPARKBOT_DEVICE_HEARTBEAT_MS=10000
# 单条 command 等待 result 的默认超时
SPARKBOT_DEVICE_COMMAND_TIMEOUT_MS=5000
# 连接后等待 hello 的时限（秒）
SPARKBOT_DEVICE_HELLO_TIMEOUT_S=5.0
# 内存里保留的最近帧数（供视觉工具复用）
SPARKBOT_DEVICE_FRAME_BUFFER_SIZE=8
# 同一 device_id 重连时是否踢掉旧连接
SPARKBOT_DEVICE_REPLACE_EXISTING_CONNECTION=true

# ---------------------------------------------------------------------------
# 大模型
# ---------------------------------------------------------------------------
# 可选：mock（离线，默认）| openai | deepseek | openai_compat
SPARKBOT_LLM_PROVIDER=mock
SPARKBOT_LLM_MODEL=gpt-4o-mini
# openai_compat 必填；其余留空走各自官方地址
# SPARKBOT_LLM_BASE_URL=http://192.168.1.10:8000/v1
# SPARKBOT_LLM_API_KEY=sk-xxxx
SPARKBOT_LLM_TEMPERATURE=0.6
SPARKBOT_LLM_MAX_TOKENS=1024
SPARKBOT_LLM_REQUEST_TIMEOUT_S=60
# 单轮对话最多允许几轮「模型思考 → 调用工具」，防止死循环
SPARKBOT_LLM_MAX_TOOL_ROUNDS=6

# ---------------------------------------------------------------------------
# 视觉理解
# ---------------------------------------------------------------------------
SPARKBOT_VISION_ENABLED=true
# 抓帧时向设备请求的分辨率
SPARKBOT_VISION_REQUEST_WIDTH=640
SPARKBOT_VISION_REQUEST_HEIGHT=480
SPARKBOT_VISION_JPEG_QUALITY=80
# 送进 VLM 前把图缩到该最长边（控制 token 成本）
SPARKBOT_VISION_DOWNSCALE_MAX_EDGE=768
SPARKBOT_VISION_TIMEOUT_S=45
# 留空则复用主 LLM 的 provider / key / base_url
# 注意：DeepSeek 的对话模型不支持图像输入，要真正看图请单独配多模态模型
# SPARKBOT_VISION_PROVIDER=openai
# SPARKBOT_VISION_MODEL=gpt-4o-mini
# SPARKBOT_VISION_API_KEY=sk-xxxx

# ---------------------------------------------------------------------------
# 语音
# ---------------------------------------------------------------------------
# 可选：mock（离线，默认）| openai | disabled
SPARKBOT_SPEECH_ASR_PROVIDER=mock
SPARKBOT_SPEECH_ASR_MODEL=whisper-1
# SPARKBOT_SPEECH_ASR_API_KEY=sk-xxxx

SPARKBOT_SPEECH_TTS_PROVIDER=mock
SPARKBOT_SPEECH_TTS_MODEL=tts-1
SPARKBOT_SPEECH_TTS_VOICE=alloy
SPARKBOT_SPEECH_TTS_FORMAT=wav
# SPARKBOT_SPEECH_TTS_API_KEY=sk-xxxx

# 唤醒后等待说话结束的静音超时（秒）
SPARKBOT_SPEECH_LISTEN_TIMEOUT_S=8.0
# 麦克风采样率，必须与设备 hello.audio.input_rate 一致
SPARKBOT_SPEECH_INPUT_SAMPLE_RATE=16000

# ---------------------------------------------------------------------------
# 行为与安全
# ---------------------------------------------------------------------------
SPARKBOT_BEHAVIOR_SAFETY_ENABLED=true
# PC 侧速度钳制上限（会与设备 hello.motor.max_* 取较小值）
SPARKBOT_BEHAVIOR_MAX_LINEAR_MPS=0.6
SPARKBOT_BEHAVIOR_MAX_ANGULAR_RPS=2.0
# 单次运动指令的最长持续时间，防止「一直往前冲」
SPARKBOT_BEHAVIOR_MAX_DURATION_MS=5000
# 两次运动指令之间的最小间隔，抑制抖动
SPARKBOT_BEHAVIOR_MIN_COMMAND_INTERVAL_MS=120
# 说话时自动切换表情
SPARKBOT_BEHAVIOR_TALKING_ANIMATION=true
# 会话历史保留条数
SPARKBOT_BEHAVIOR_HISTORY_LIMIT=40

# ---------------------------------------------------------------------------
# 其它
# ---------------------------------------------------------------------------
SPARKBOT_ARTIFACTS_DIR=artifacts
# 机器人人格，会注入 system prompt。改这里就能换「性格」。
# SPARKBOT_PERSONA=你是「小星」，一台可爱的履带式桌面机器人……
