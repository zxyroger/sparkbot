# Python 虚拟环境（本机依赖，不入库）
.venv/

# ModelScope 模型缓存（约 900MB，首次运行自动下载）
modelscope-cache/

# Kokoro 语音模型（约 450MB，见 README/tts_server.py 的下载说明）
models/

# 运行期 HOME：内含 .modelscope 凭据，绝不能入库
home/

# torch 编译缓存
torchinductor_*/

# Python
__pycache__/
*.py[cod]

# jieba 分词缓存（misaki 中文 G2P 在服务目录里落地）
jieba.cache

# 基准测试输出（音频样本）
bench/

# 编辑器
.vscode/
.idea/
